rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && request.auth.uid == '3gXPMPACBeftCtoSGqC6mL5T2iw2';
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Server-owned economy: clients cannot create or alter balances.
    // Owner may adjust ONLY balance of an existing profile.
    match /users/{uid} {
      allow read: if isSelf(uid) || isOwner();
      allow create, delete: if false;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])
        && request.resource.data.balance is int
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= 1000000000;
    }

    // Owner-created virtual item catalog.
    match /adminItems/{itemId} {
      allow read: if signedIn();
      allow create: if isOwner()
        && itemId.matches('admin_[A-Za-z0-9_-]{20,}')
        && request.resource.data.keys().hasOnly(['id','name','emoji','rarity','value','adminItem','creator'])
        && request.resource.data.id == itemId
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.adminItem == true
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() >= 1
        && request.resource.data.emoji.size() <= 8
        && request.resource.data.rarity in ['common','rare','epic','legendary']
        && request.resource.data.value is int
        && request.resource.data.value >= 1
        && request.resource.data.value <= 100000000;
      allow update, delete: if false;
    }


    // Owner-defined collectible cases. Drops are item IDs with exact percentage weights.
    match /adminCases/{caseId} {
      allow read: if signedIn();
      allow create: if isOwner()
        && caseId.matches('acase_[A-Za-z0-9_-]{20,}')
        && request.resource.data.keys().hasOnly(['id','name','emoji','price','tier','adminCase','creator','drops'])
        && request.resource.data.id == caseId
        && request.resource.data.creator == request.auth.uid
        && request.resource.data.adminCase == true
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 40
        && request.resource.data.emoji is string
        && request.resource.data.emoji.size() >= 1
        && request.resource.data.emoji.size() <= 8
        && request.resource.data.price is int
        && request.resource.data.price >= 1
        && request.resource.data.price <= 100000000
        && request.resource.data.tier == 3
        && request.resource.data.drops is list
        && request.resource.data.drops.size() >= 1
        && request.resource.data.drops.size() <= 20;
      allow update, delete: if false;
    }

    // Transactional settlement: recipient may update sender's inventory ONLY
    // when a pending trade is accepted in the same atomic transaction.
    function validTradeSide(uid) {
      let id = request.resource.data.state.get('lastTradeId', '');
      let before = get(/databases/$(database)/documents/tradeRequests/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/tradeRequests/$(id)).data;
      let old = resource.data.state;
      let next = request.resource.data.state;
      let senderSide = uid == before.sender;
      let give = senderSide ? before.offerCard : before.wantCard;
      let take = senderSide ? before.wantCard : before.offerCard;
      let paid = senderSide ? before.offerVC : before.wantVC;
      let received = senderSide ? before.wantVC : before.offerVC;
      return signedIn()
        && id is string && id.size() >= 10 && id.size() <= 128
        && before.status == 'pending' && after.status == 'accepted'
        && before.recipient == request.auth.uid
        && uid in [before.sender,before.recipient]
        && request.resource.data.keys().hasOnly(['state','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && next.uid == uid && next.lastTradeId == id
        && next.diff(old).affectedKeys().hasOnly(['inventory','balance','collected','showcase','lastTradeId'])
        && old.inventory is map && next.inventory is map
        && old.balance is number && next.balance is number
        && old.balance >= paid && next.balance == old.balance - paid + received
        && next.balance >= 0 && next.balance <= 1000000000
        && next.inventory.diff(old.inventory).affectedKeys().hasOnly([give,take])
        && (give == '' || (old.inventory.get(give,0) >= 1
             && next.inventory.get(give,0) == old.inventory.get(give,0) - 1))
        && (take == '' || next.inventory.get(take,0) == old.inventory.get(take,0) + 1);
    }


    function marketProfileChange(uid) {
      let id = request.resource.data.state.get('lastMarketId','');
      let before = get(/databases/$(database)/documents/marketListings/$(id));
      let after = getAfter(/databases/$(database)/documents/marketListings/$(id));
      let old = resource.data.state;
      let next = request.resource.data.state;
      let listing = after.data;
      let selling = !before.exists() && listing.status == 'active' && listing.seller == uid && uid == request.auth.uid;
      let cancelling = before.exists() && before.data.status == 'active' && listing.status == 'cancelled' && listing.seller == uid && uid == request.auth.uid;
      let buying = before.exists() && before.data.status == 'active' && listing.status == 'sold' && listing.buyer == request.auth.uid && uid == request.auth.uid;
      let crediting = before.exists() && before.data.status == 'active' && listing.status == 'sold' && listing.seller == uid && listing.buyer == request.auth.uid;
      let delta = selling ? -1 : cancelling || buying ? 1 : 0;
      return signedIn() && id is string && id.size() >= 10 && id.size() <= 128
        && (selling || cancelling || buying || crediting)
        && request.resource.data.keys().hasOnly(['state','updatedAt'])
        && request.resource.data.updatedAt == request.time
        && next.uid == uid && next.lastMarketId == id
        && next.diff(old).affectedKeys().hasOnly(['inventory','balance','collected','showcase','lastMarketId'])
        && old.inventory is map && next.inventory is map
        && next.inventory.diff(old.inventory).affectedKeys().hasOnly([listing.cardId])
        && (crediting ? next.inventory == old.inventory
          : next.inventory.get(listing.cardId,0) == old.inventory.get(listing.cardId,0) + delta)
        && (!selling || old.inventory.get(listing.cardId,0) >= 1)
        && (selling || cancelling ? next.balance == old.balance
          : buying ? old.balance >= listing.price && next.balance == old.balance - listing.price
          : next.balance == old.balance + int(listing.price * 97 / 100))
        && next.balance >= 0 && next.balance <= 1000000000;
    }

    match /marketListings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['seller','cardId','price','status','createdAt'])
        && request.resource.data.seller == request.auth.uid
        && request.resource.data.cardId is string
        && request.resource.data.cardId.size() >= 1
        && request.resource.data.cardId.size() <= 100
        && request.resource.data.price is int
        && request.resource.data.price >= 1
        && request.resource.data.price <= 100000000
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/gameProfiles/$(request.auth.uid)).data.state.lastMarketId == listingId;
      allow update: if signedIn()
        && resource.data.status == 'active'
        && ((
          resource.data.seller == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','closedAt'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.closedAt == request.time
          && getAfter(/databases/$(database)/documents/gameProfiles/$(request.auth.uid)).data.state.lastMarketId == listingId
        ) || (
          resource.data.seller != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','buyer','closedAt'])
          && request.resource.data.status == 'sold'
          && request.resource.data.buyer == request.auth.uid
          && request.resource.data.closedAt == request.time
          && getAfter(/databases/$(database)/documents/gameProfiles/$(request.auth.uid)).data.state.lastMarketId == listingId
          && getAfter(/databases/$(database)/documents/gameProfiles/$(resource.data.seller)).data.state.lastMarketId == listingId
        ));
      allow delete: if false;
    }
    // Prototype account-based save. Client-writable: not anti-cheat secure.
    match /gameProfiles/{uid} {
      allow get: if signedIn();
      allow list: if isOwner();
      allow create, update: if validTradeSide(uid) || marketProfileChange(uid) || isOwner() || isSelf(uid)
        && request.resource.data.keys().hasOnly(['state','updatedAt'])
        && request.resource.data.state is map
        && request.resource.data.state.uid == uid
        && request.resource.data.state.inventory is map
        && request.resource.data.state.balance is number
        && request.resource.data.state.balance >= 0
        && request.resource.data.state.balance <= 1000000000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Public leaderboard snapshot; clients cannot forge rankings.
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['nick','xp','opens','inventoryValue','updatedAt'])
        && request.resource.data.nick is string
        && request.resource.data.nick.size() >= 1
        && request.resource.data.nick.size() <= 20
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0
        && request.resource.data.xp <= 1000000000
        && request.resource.data.opens is int
        && request.resource.data.opens >= 0
        && request.resource.data.opens <= 1000000000
        && request.resource.data.inventoryValue is int
        && request.resource.data.inventoryValue >= 0
        && request.resource.data.inventoryValue <= 1000000000000
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Public profile/showcase: readable, but cannot be forged client-side.
    match /showcases/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /catalog/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /adminAudit/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Unique nickname reservation; one owner per lowercase nickname.
    match /nicknames/{nick} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && nick.matches('[a-z0-9_]{3,20}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /tradeProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['uid','nick','nickLower','updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.nick is string
        && request.resource.data.nick.matches('[A-Za-z0-9_]{3,20}')
        && request.resource.data.nickLower is string
        && request.resource.data.nickLower.matches('[a-z0-9_]{3,20}')
        && request.resource.data.updatedAt == request.time
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.nickLower)).data.uid == uid;
      allow delete: if false;
    }

    // Trades settle inventory and VC atomically with gameProfiles.
    match /tradeRequests/{tradeId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['sender','recipient','offerCard','wantCard','offerVC','wantVC','status','createdAt'])
        && request.resource.data.sender == request.auth.uid
        && request.resource.data.recipient is string
        && request.resource.data.recipient.matches('[A-Za-z0-9]{20,128}')
        && request.resource.data.recipient != request.auth.uid
        && request.resource.data.offerCard is string
        && request.resource.data.offerCard.size() <= 100
        && request.resource.data.wantCard is string
        && request.resource.data.wantCard.size() <= 100
        && request.resource.data.offerVC is int
        && request.resource.data.offerVC >= 0
        && request.resource.data.offerVC <= 100000000
        && request.resource.data.wantVC is int
        && request.resource.data.wantVC >= 0
        && request.resource.data.wantVC <= 100000000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get, list: if signedIn()
        && (resource.data.sender == request.auth.uid || resource.data.recipient == request.auth.uid);
      allow update: if signedIn()
        && resource.data.recipient == request.auth.uid
        && resource.data.status == 'pending'
        && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
             && request.resource.data.status == 'declined')
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','settledAt'])
             && request.resource.data.status == 'accepted'
             && request.resource.data.settledAt == request.time
             && getAfter(/databases/$(database)/documents/gameProfiles/$(resource.data.sender)).data.state.lastTradeId == tradeId
             && getAfter(/databases/$(database)/documents/gameProfiles/$(resource.data.recipient)).data.state.lastTradeId == tradeId));
      allow delete: if false;
    }

    match /operations/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}