rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isOwner() {
      return signedIn() && request.auth.uid == '3gXPMPACBeftCtoSGqC6mL5T2iw2';
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Server-owned economy: clients cannot create or alter balances.
    // Owner may adjust ONLY balance of an existing profile.
    match /users/{uid} {
      allow read: if isSelf(uid) || isOwner();
      allow create, delete: if false;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance'])
        && request.resource.data.balance is int
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= 1000000000;
    }

    // Public leaderboard snapshot; clients cannot forge rankings.
    match /leaderboard/{uid} {
      allow read: if true;
      allow write: if false;
    }

    // Public profile/showcase: readable, but cannot be forged client-side.
    match /showcases/{uid} {
      allow read: if true;
      allow write: if false;
    }

    match /catalog/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /adminAudit/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // Requests only. No item or currency transfer occurs here.
    match /tradeRequests/{tradeId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['sender','recipient','offer','want','status','createdAt'])
        && request.resource.data.sender == request.auth.uid
        && request.resource.data.recipient is string
        && request.resource.data.recipient.matches('[A-Za-z0-9]{20,128}')
        && request.resource.data.recipient != request.auth.uid
        && request.resource.data.offer is string
        && request.resource.data.offer.size() > 0
        && request.resource.data.offer.size() <= 120
        && request.resource.data.want is string
        && request.resource.data.want.size() > 0
        && request.resource.data.want.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow get, list: if signedIn()
        && (resource.data.sender == request.auth.uid || resource.data.recipient == request.auth.uid);
      allow update: if signedIn()
        && resource.data.recipient == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted','declined'];
      allow delete: if false;
    }

    match /operations/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}